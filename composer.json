{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/razorext2/laravel-sign-pad.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "asantibanez/livewire-charts": "^4.1",
        "barryvdh/laravel-debugbar": "^3.14",
        "barryvdh/laravel-dompdf": "^3.1",
        "creagia/laravel-sign-pad": "dev-main",
        "intervention/image": "^3.11",
        "jfcherng/php-diff": "^6.16",
        "laravel-notification-channels/webpush": "^10.2",
        "laravel/breeze": "^2.1",
        "laravel/framework": "^11.44",
        "laravel/horizon": "^5.47",
        "laravel/octane": "^2.6",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "livewire/livewire": "^3.5",
        "maatwebsite/excel": "^3.1",
        "power-components/livewire-powergrid": "^6.1",
        "predis/predis": "2.0",
        "pusher/pusher-php-server": "^7.2",
        "riskihajar/terbilang": "^2.0",
        "silviolleite/laravelpwa": "^2.0",
        "spatie/laravel-backup": "^9.2",
        "spatie/laravel-permission": "^6.9",
        "symfony/css-selector": "^7.3",
        "symfony/dom-crawler": "^7.3",
        "yajra/laravel-datatables": "^11.0",
        "yajra/laravel-datatables-oracle": "11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^1.1",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/getCurrentDate.php",
            "app/Helpers/countDistance.php",
            "app/Helpers/errorLogger.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
